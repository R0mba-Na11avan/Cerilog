{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cerilog",
  "scopeName": "source.cerilog",
  "fileTypes": [
    "cel"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#module-declaration"
    },
    {
      "include": "#instance"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#system-functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cerilog",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cerilog",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "module-declaration": {
      "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_$]*)",
      "captures": {
        "1": {
          "name": "storage.type.module.cerilog"
        },
        "2": {
          "name": "entity.name.type.module.cerilog"
        }
      }
    },
    "instance": {
      "comment": "Adder #(...) u_add (  or  Adder u_add (",
      "match": "^\\s*(?!(?:if|else|case|casez|default|for|always|always_ff|always_comb|assign|module|logic|localparam|parameter|input|output|inout)\\b)([A-Za-z_][A-Za-z0-9_$]*)(?=\\s*(#|[A-Za-z_][A-Za-z0-9_$]*\\s*\\())",
      "captures": {
        "1": {
          "name": "entity.name.type.instance.cerilog"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cerilog",
          "match": "\\b(if|else|case|casez|default|for)\\b"
        },
        {
          "name": "keyword.other.always.cerilog",
          "match": "\\b(always|always_ff|always_comb|assign)\\b"
        },
        {
          "name": "keyword.other.edge.cerilog",
          "match": "\\b(posedge|negedge|or)\\b"
        },
        {
          "name": "storage.modifier.direction.cerilog",
          "match": "\\b(input|output|inout)\\b"
        },
        {
          "name": "storage.type.cerilog",
          "match": "\\b(logic|int|integer|genvar|signed|parameter|localparam)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.based.cerilog",
          "match": "(\\b\\d[\\d_]*)?'[sS]?[bBoOdDhH][0-9a-fA-FxXzZ?_]+"
        },
        {
          "name": "constant.numeric.fill.cerilog",
          "match": "'[01xXzZ]\\b"
        },
        {
          "name": "constant.numeric.decimal.cerilog",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "system-functions": {
      "name": "support.function.system.cerilog",
      "match": "\\$[A-Za-z_][A-Za-z0-9_$]*"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.cerilog",
          "match": "<=(?!=)|(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.cerilog",
          "match": "===|!==|==|!=|>=|&&|\\|\\||<<<|>>>|<<|>>|\\*\\*|\\+\\+|--|\\+=|-=|\\+:|-:|~&|~\\||~\\^|\\^~|[+\\-*/%&|^~!<>?:]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.cerilog",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.cerilog",
          "match": ","
        },
        {
          "name": "punctuation.accessor.port.cerilog",
          "match": "\\.(?=[A-Za-z_])"
        },
        {
          "name": "punctuation.definition.parameters.cerilog",
          "match": "#"
        }
      ]
    }
  }
}
