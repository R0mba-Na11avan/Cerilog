// mux.cel
// A small ALU. Shows: case with stacked labels (fallthrough), combinational always.

module Alu(
    input  logic[3:0] opcode,
    input  logic[7:0] a,
    input  logic[7:0] b,
    output logic[7:0] result
) {
    always() {
        case (opcode) {
            4'h0:
            4'h1:
            4'h2: result = a + b;   // 0, 1 and 2 all land here

            4'h3:
            4'h4: result = a - b;

            4'h5: result = a & b;
            4'h6: result = a | b;
            default: result = '0;
        }
    }
}
